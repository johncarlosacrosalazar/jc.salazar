    "responses": {
      "en": {
        "agent.whoami": [
          {
            "answer": "I'm JC's NLP AI assistant, entirely self-hosted! I'm here to answer questions about his professional background."
          }
        ],
        "greetings.hello": [
          {
            "answer": "Hello there! I'm an NLP bot for John Carlo Salazar. Feel free to ask about his experience, projects, or contact info."
          }
        ],
        "john.about": [
          {
            "answer": "John Carlo Salazar is a Lead Web Developer & Systems Architect with 10+ years of experience engineering high-performance ecosystems for Singapore and the Philippines."
          }
        ],
        "john.experience": [
          {
            "answer": "John has over 10 years of experience. His professional history includes: Lead Web Developer & QA Lead at Edge Digital (2020-2025), Full-Stack Developer at Breakthrough4business (2017-2019), and Junior Programmer at Leentech Network Solution (2016-2017)."
          }
        ],
        "john.exp.edge": [
          {
            "answer": "John worked at Edge Digital as a Lead Web Developer and QA Lead from 2020 to 2025. He led projects like OnePeople Online and mission-critical sites for the Temasek Foundation."
          }
        ],
        "john.exp.b4b": [
          {
            "answer": "John was a Full-Stack Web Developer at Breakthrough4business (B4B) from 2017 to 2019, where he developed the B4B Academy social learning platform."
          }
        ],
        "john.exp.leentech": [
          {
            "answer": "John started his career as a Junior Programmer at Leentech Network Solution from 2016 to 2017, focusing on Magento e-commerce and Ionic mobile development."
          }
        ],
        "john.skills": [
          {
            "answer": "John specializes in React, Next.js, Node.js, AWS Lambda, Laravel, and Enterprise QA. He is a full-stack expert with deep knowledge in serverless architecture and high-performance UI."
          }
        ],
        "john.projects": [
          {
            "answer": "John's portfolio includes the Phuckjs Page Builder, JSX Dashboard, Temasek Foundation COVID-19 sites, and OnePeople Online. You can see more details in the Projects section above!"
          }
        ],
        "john.contact": [
          {
            "answer": "You can contact John via email at johncarlosacrosalazar@gmail.com, via WhatsApp at +639273315906, or find him on LinkedIn."
          }
        ],
        "john.location": [
          {
            "answer": "John is based in Trece Martires, Cavite, Philippines, but has extensive experience working with clients and teams in Singapore."
          }
        ],
        "john.education": [
          {
            "answer": "John's education details are available upon request, but he holds over a decade of hands-on experience in the software engineering industry."
          }
        ],
        "john.hire": [
          {
            "answer": "John is always open to discussing interesting new projects or roles. Feel free to reach out via email or WhatsApp!"
          }
        ],
        "john.resume": [
          {
            "answer": "You can view John's full CV right here on this site, or contact him directly if you need a PDF copy."
          }
        ],
