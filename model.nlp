wnload resume\"\n      ],\n      [\n        \"en\",\n        \"can I see your cv\"\n      ]\n    ]\n  },\n  \"ner\": {\n    \"settings\": {\n      \"tag\": \"ner\",\n      \"entityPreffix\": \"%\",\n      \"entitySuffix\": \"%\"\n    },\n    \"rules\": {}\n  },\n  \"nlgManager\": {\n    \"settings\": {\n      \"tag\": \"nlg-manager\"\n    },\n    \"responses\": {\n      \"en\": {\n        \"agent.whoami\": [\n          {\n            \"answer\": \"I'm JC's NLP AI assistant, entirely self-hosted! I'm here to answer questions about his professional background.\"\n          }\n        ],\n        \"greetings.hello\": [\n          {\n            \"answer\": \"Hello there! I'm an NLP bot for John Carlo Salazar. Feel free to ask about his experience, projects, or contact info.\"\n          }\n        ],\n        \"john.about\": [\n          {\n            \"answer\": \"John Carlo Salazar (or just Carlo) is a Lead Web Developer & Systems Architect with 10+ years of experience engineering high-performance ecosystems for Singapore and the Philippines.\"\n          }\n        ],\n        \"john.experience\": [\n          {\n            \"answer\": \"John has over 10 years of experience. His professional history includes: Lead Web Developer & QA Lead at Edge Digital (2020-2025), Full-Stack Developer at Breakthrough4business (2017-2019), and Junior Programmer at Leentech Network Solution (2016-2017).\"\n          }\n        ],\n        \"john.exp.edge\": [\n          {\n            \"answer\": \"John worked at Edge Digital as a Lead Web Developer and QA Lead from 2020 to 2025. He led projects like OnePeople Online and mission-critical sites for the Temasek Foundation.\"\n          }\n        ],\n        \"john.exp.b4b\": [\n          {\n            \"answer\": \"John was a Full-Stack Web Developer at Breakthrough4business (B4B) from 2017 to 2019, where he developed the B4B Academy social learning platform.\"\n          }\n        ],\n        \"john.exp.leentech\": [\n          {\n            \"answer\": \"John started his career as a Junior Programmer at Leentech Network Solution from 2016 to 2017, focusing on Magento e-commerce and Ionic mobile development.\"\n          }\n        ],\n        \"john.skills\": [\n          {\n            \"answer\": \"John specializes in React, Next.js, Node.js, AWS Lambda, Laravel, and Enterprise QA. He is a full-stack expert with deep knowledge in serverless architecture and high-performance UI.\"\n          }\n        ],\n        \"john.projects\": [\n          {\n            \"answer\": \"John's portfolio includes the Phuckjs Page Builder, JSX Dashboard, Temasek Foundation COVID-19 sites, and OnePeople Online. Which one would you like to know more about?\"\n          }\n        ],\n        \"john.proj.onepeople\": [\n          {\n            \"answer\": \"<b>OnePeople</b> is a platform that connects people with different views through open dialogue and global voting. By sharing perspectives and participating in referendums, it helps communities understand each other and use collective insight to shape a better future.\"\n          }\n        ],\n        \"john.proj.phuckjs\": [\n          {\n            \"answer\": \"<b>Phuckjs Page Builder</b> is a premium personal project. It's a highly dynamic website builder engine developed by John to streamline complex UI creation.\"\n          }\n        ],\n        \"john.proj.jsx\": [\n          {\n            \"answer\": \"<b>JSX Dashboard</b> is a high-performance administrative interface project showcasing John's expertise in real-time data visualization and complex state management.\"\n          }\n        ],\n        \"john.proj.temasek\": [\n          {\n            \"answer\": \"John led the engineering for several nationwide COVID-19 response platforms for the <b>Temasek Foundation</b> in Singapore, including StayPrepared, Oximeter, Staymasked, and BYOBClean.\"\n          }\n        ],\n        \"john.proj.stayprepared\": [\n          {\n            \"answer\": \"<b>StayPrepared</b> is a Temasek Foundation initiative that strengthens Singapore’s emergency resilience through health programs, mask distribution, and community training.\"\n          }\n        ],\n        \"john.proj.pentagreen\": [\n          {\n            \"answer\": \"<b>Pentagreen Capital</b> is a debt financing platform launched by HSBC and Temasek to accelerate the development of sustainable infrastructure projects in Southeast Asia and beyond.\"\n          }\n        ],\n        \"john.proj.oximeter\": [\n          {\n            \"answer\": \"The <b>Oximeter</b> project was an e-commerce and distribution platform for pulse oximeters to help Singapore households monitor their health during the pandemic.\"\n          }\n        ],\n        \"john.proj.staymasked\": [\n          {\n            \"answer\": \"<b>Staymasked</b> is a nationwide distribution platform that provided free masks to Singapore residents via automated vending machines.\"\n          }\n        ],\n        \"john.proj.byobclean\": [\n          {\n            \"answer\": \"<b>BYOBClean</b> (Bring Your Own Bottle) was a Temasek Foundation initiative where Singapore households could collect free hand sanitizer to help reduce plastic waste.\"\n          }\n        ],\n        \"john.proj.lola\": [\n          {\n            \"answer\": \"<b>Lola's Plates & Pours</b> is a full-stack Next.js application designed to showcase modern UI/UX design and seamless restaurant management features.\"\n          }\n        ],\n        \"john.contact\": [\n          {\n            \"answer\": \"You can contact John via email at <a href='mailto:johncarlosacrosalazar@gmail.com'>johncarlosacrosalazar@gmail.com</a>, via WhatsApp at <a href='https://wa.me/639273315906' target='_blank'>+639273315906</a>, or find him on <a href='https://www.linkedin.com/in/john-carlo-salazar-8028083b6/' target='_blank'>LinkedIn</a>.\"\n          }\n        ],\n        \"john.location\": [\n          {\n            \"answer\": \"John lives in Brgy. San Agustin, Trece Martires City, Cavite, Philippines.\"\n          }\n        ],\n        \"john.birthday\": [\n          {\n            \"answer\": \"John was born on December 16, 1993. As of today, he is 32 years old.\"\n          }\n        ],\n        \"john.status\": [\n          {\n            \"answer\": \"John is married since December 15, 2025.\"\n          }\n        ],\n        \"john.nickname\": [\n          {\n            \"answer\": \"You can call him Carlo!\"\n          }\n        ],\n        \"john.education\": [\n          {\n            \"answer\": \"John graduated from Colegio de Amore, Batch 2014, where he was awarded 'Best in OJT'.\"\n          }\n        ],\n        \"john.strengths\": [\n          {\n            \"answer\": \"John's core strengths include his 10+ years of <b>Systems Architecture</b> expertise, a deep mastery of <b>Enterprise QA</b> for high-stakes projects, and his ability to architect scalable <b>AWS Serverless</b> ecosystems. He is known for his precision, adaptability across tech stacks, and leadership in mission-critical environments.\"\n          }\n        ],\n        \"john.hire\": [\n          {\n            \"answer\": \"John is always open to discussing interesting new projects or roles. Feel free to reach out via email or WhatsApp!\"\n          }\n        ],\n        \"john.resume\": [\n          {\n            \"answer\": \"You can view John's full CV right here on this site, or contact him directly if you need a PDF copy.\"\n          }\n        ],\n        \"None\": [\n          {\n            \"answer\": \"I'm sorry, I don't have information on that specific detail. Try asking me about John's experience, skills, projects, or how to contact him!\"\n          }\n        ]\n      }\n    }\n  },\n  \"actionManager\": {\n    \"settings\": {\n      \"tag\": \"action-manager\"\n    },\n    \"actions\": {}\n  },\n  \"slotManager\": {}\n}"