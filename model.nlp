"en","show projects"],["en","list projects"],["en","what is onepeople"],["en","tell me about onepeople"],["en","onepeople online"],["en","what is phuckjs"],["en","phuckjs page builder"],["en","what is jsx dashboard"],["en","jsx dashboard"],["en","temasek foundation projects"],["en","stayprepared"],["en","what is stayprepared"],["en","oximeter"],["en","staymasked"],["en","byobclean"],["en","pentagreen capital"],["en","what is pentagreen"],["en","what are the covid sites"],["en","lolas plates and pours"],["en","what is lolas"],["en","how can I contact you"],["en","what is your email"],["en","phone number"],["en","whatsapp"],["en","social media"],["en","linkedin"],["en","how to contact him"],["en","his email"],["en","his contact details"],["en","his phone number"],["en","his whatsapp"],["en","john's contact"],["en","where do you live"],["en","what is your address"],["en","where are you located"],["en","current location"],["en","are you based in singapore"],["en","what is your birthday"],["en","when were you born"],["en","your birthday"],["en","how old are you"],["en","your age"],["en","what is your age"],["en","how old is john"],["en","birth date"],["en","are you married"],["en","marital status"],["en","who is your wife"],["en","do you have a wife"],["en","are you single"],["en","is he married"],["en","johns wife"],["en","civil status"],["en","what is your nickname"],["en","nickname"],["en","what can I call you"],["en","what is your education"],["en","where did you study"],["en","degree"],["en","college"],["en","university"],["en","school history"],["en","education history"],["en","his school history"],["en","schooling"],["en","educational background"],["en","honors"],["en","ojt"],["en","best in ojt"],["en","awards"],["en","what are your strengths"],["en","professional strengths"],["en","why should I hire you"],["en","your advantage"],["en","what makes you different"],["en","are you for hire"],["en","can I hire you"],["en","available for work"],["en","freelance"],["en","job opportunities"],["en","resume"],["en","cv"],["en","download resume"],["en","can I see your cv"]]},"ner":{"settings":{"tag":"ner","entityPreffix":"%","entitySuffix":"%"},"rules":{}},"nlgManager":{"settings":{"tag":"nlg-manager"},"responses":{"en":{"agent.whoami":[{"answer":"I'm JC's NLP AI assistant, entirely self-hosted! I'm here to answer questions about his professional background."}],"greetings.hello":[{"answer":"Hello there! I'm an NLP bot for John Carlo Salazar. Feel free to ask about his experience, projects, or contact info."}],"john.about":[{"answer":"John Carlo Salazar (or just Carlo) is a Lead Web Developer & Systems Architect with 10+ years of experience engineering high-performance ecosystems for Singapore and the Philippines."}],"john.experience":[{"answer":"John has over 10 years of experience. His professional history includes: Lead Web Developer & QA Lead at Edge Digital (2020-2025), Full-Stack Developer at Breakthrough4business (2017-2019), and Junior Programmer at Leentech Network Solution (2016-2017)."}],"john.exp.edge":[{"answer":"John worked at Edge Digital as a Lead Web Developer and QA Lead from 2020 to 2025. He led projects like OnePeople Online and mission-critical sites for the Temasek Foundation."}],"john.exp.b4b":[{"answer":"John was a Full-Stack Web Developer at Breakthrough4business (B4B) from 2017 to 2019, where he developed the B4B Academy social learning platform."}],"john.exp.leentech":[{"answer":"John started his career as a Junior Programmer at Leentech Network Solution from 2016 to 2017, focusing on Magento e-commerce and Ionic mobile development."}],"john.skills":[{"answer":"John specializes in React, Next.js, Node.js, AWS Lambda, Laravel, and Enterprise QA. He is a full-stack expert with deep knowledge in serverless architecture and high-performance UI."}],"john.projects":[{"answer":"John's portfolio includes the Phuckjs Page Builder, JSX Dashboard, Temasek Foundation COVID-19 sites, and OnePeople Online. Which one would you like to know more about?"}],"john.proj.onepeople":[{"answer":"<b>OnePeople</b> is a platform that connects people with different views through open dialogue and global voting. By sharing perspectives and participating in referendums, it helps communities understand each other and use collective insight to shape a better future."}],"john.proj.phuckjs":[{"answer":"<b>Phuckjs Page Builder</b> is a premium personal project. It's a highly dynamic website builder engine developed by John to streamline complex UI creation."}],"john.proj.jsx":[{"answer":"<b>JSX Dashboard</b> is a high-performance administrative interface project showcasing John's expertise in real-time data visualization and complex state management."}],"john.proj.temasek":[{"answer":"John led the engineering for several nationwide COVID-19 response platforms for the <b>Temasek Foundation</b> in Singapore, including StayPrepared, Oximeter, Staymasked, and BYOBClean."}],"john.proj.stayprepared":[{"answer":"<b>StayPrepared</b> is a Temasek Foundation initiative that strengthens Singapore’s emergency resilience through health programs, mask distribution, and community training."}],"john.proj.pentagreen":[{"answer":"<b>Pentagreen Capital</b> is a debt financing platform launched by HSBC and Temasek to accelerate the development of sustainable infrastructure projects in Southeast Asia and beyond."}],"john.proj.oximeter":[{"answer":"The <b>Oximeter</b> project was an e-commerce and distribution platform for pulse oximeters to help Singapore households monitor their health during the pandemic."}],"john.proj.staymasked":[{"answer":"<b>Staymasked</b> is a nationwide distribution platform that provided free masks to Singapore residents via automated vending machines."}],"john.proj.byobclean":[{"answer":"<b>BYOBClean</b> (Bring Your Own Bottle) was a Temasek Foundation initiative where Singapore households could collect free hand sanitizer to help reduce plastic waste."}],"john.proj.lola":[{"answer":"<b>Lola's Plates & Pours</b> is a full-stack Next.js application designed to showcase modern UI/UX design and seamless restaurant management features."}],"john.contact":[{"answer":"You can contact John via email at <a href='mailto:johncarlosacrosalazar@gmail.com'>johncarlosacrosalazar@gmail.com</a>, via WhatsApp at <a href='https://wa.me/639273315906' target='_blank'>+639273315906</a>, or find him on <a href='https://www.linkedin.com/in/john-carlo-salazar-8028083b6/' target='_blank'>LinkedIn</a>."}],"john.location":[{"answer":"John lives in Brgy. San Agustin, Trece Martires City, Cavite, Philippines."}],"john.birthday":[{"answer":"John was born on December 16, 1993. As of today, he is 32 years old."}],"john.status":[{"answer":"John is married since December 15, 2025."}],"john.nickname":[{"answer":"You can call him Carlo!"}],"john.education":[{"answer":"John graduated from Colegio de Amore, Batch 2014, where he was awarded 'Best in OJT'."}],"john.strengths":[{"answer":"John's core strengths include his 10+ years of <b>Systems Architecture</b> expertise, a deep mastery of <b>Enterprise QA</b> for high-stakes projects, and his ability to architect scalable <b>AWS Serverless</b> ecosystems. He is known for his precision, adaptability across tech stacks, and leadership in mission-critical environments."}],"john.hire":[{"answer":"John is always open to discussing interesting new projects or roles. Feel free to reach out via email or WhatsApp!"}],"john.resume":[{"answer":"You can view John's full CV right here on this site, or contact him directly if you need a PDF copy."}],"None":[{"answer":"I'm sorry, I don't have information on that specific detail. Try asking me about John's experience, skills, projects, or how to contact him!"}]}}},"actionManager":{"settings":{"tag":"action-manager"},"actions":{}},"slotManager":{}}